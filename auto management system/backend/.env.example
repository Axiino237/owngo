PORT=5000
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/crm_db

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Email (SMTP for OTPs and notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=user@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM=CRM System <user@example.com>

# Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=superadmin@crm.com
SUPER_ADMIN_PASSWORD=YourSecurePassword123
SUPER_ADMIN_NAME=Super Admin

# Web Push VAPID Keys for Background Notifications (Chrome, Safari, Android, iOS PWA)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com
